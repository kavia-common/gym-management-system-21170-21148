# Application
APP_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS. Add your preview domains as needed.
# Example for previews:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://*.beta01.cloud.kavia.ai,https://*.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000

# Security
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TEST_MODE=true

# Database
DATABASE_URL=
DATABASE_URL_SQLITE=sqlite:///./app.db
DB_ECHO=false

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
