# Backend .env example

APP_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Database (SQLite default)
DATABASE_URL_SQLITE=sqlite:///./app.db
DB_ECHO=false

# Auth (backend local)
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (for JWT validation of Supabase-issued tokens)
SUPABASE_URL=https://your-project.supabase.co

# Google OAuth (if using backend Google flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Payments (optional)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Test mode
TEST_MODE=true
