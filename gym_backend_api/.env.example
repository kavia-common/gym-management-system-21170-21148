# Application
APP_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list. You can include wildcards if your platform supports them.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Security
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TEST_MODE=true

# Database
# If DATABASE_URL is unset, app will use SQLite fallback below.
DATABASE_URL=
DATABASE_URL_SQLITE=sqlite:///./app.db
DB_ECHO=false

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Google OAuth
# Obtain these from Google Cloud Console -> Credentials (OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI configured in Google Cloud.
# For local dev:
# http://localhost:3001/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
